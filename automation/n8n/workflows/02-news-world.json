    {
      "parameters": {
        "jsCode": "const source=$('Loop Through Sections').item.json;const text=$json.choices?.[0]?.message?.content;if(!text)throw new Error('Section writer returned no text.');return [{json:{index:source.index,heading:source.section.heading,text:String(text),category:source.category}}];"
      },
      "id": "18d9b948-0463-47a0-b6d5-269857283e85",
